{
  "name": "sawitheight-r-desktop",
  "version": "0.3.1",
  "description": "Aplikasi desktop analisis tinggi pohon sawit dari dense point cloud fotogrametri dengan backend R/lidR, referensi tanah independen, dan monitoring tinggi multi-periode dan klasifikasi status pertumbuhan.",
  "main": "src/main.js",
  "author": "PMNP",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never",
    "dist:installer": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.pmnp.sawitheight",
    "productName": "SawitHeight R",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "r/**/*",
      "package.json"
    ],
    "extraResources": [
      "r/**/*",
      {
        "from": "vendor/R",
        "to": "vendor/R",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SawitHeight-R-Portable-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "SawitHeight-R-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SawitHeight R"
    },
    "asarUnpack": [
      "r/**/*"
    ]
  }
}
